# Copia in .env.local per sviluppare con gli account attivi. Senza queste variabili il sito funziona
# comunque (editor + PDF) e i pulsanti account mostrano "Accounts are not enabled on this site yet".
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
